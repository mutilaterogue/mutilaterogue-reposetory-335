<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<Script file="DamageMeterEntry.lua"/>

	<Button name="DamageMeterEntryTemplate" mixin="DamageMeterEntryMixin" virtual="true">
		<Size x="240" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="ShadowBG" atlas="ui-damagemeters-bar-shadowbg" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="ShadowEdge" atlas="ui-damagemeters-bar-shadowedge" setAllPoints="true"/>
				<Texture parentKey="Highlight" atlas="ui-questtrackerbutton-red-highlight" alphaMode="ADD" hidden="true" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Frames>
			<StatusBar parentKey="Bar">
				<Anchors>
					<Anchor point="TOPLEFT" x="1" y="-1"/>
					<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Icon" hidden="true">
							<Size x="16" y="16"/>
							<Anchors>
								<Anchor point="LEFT" x="20" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Rank" inherits="GameFontHighlightSmall" justifyH="LEFT">
							<Size x="18" y="0"/>
							<Anchors>
								<Anchor point="LEFT" x="3" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Name" inherits="GameFontHighlightSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="LEFT" x="22" y="0"/>
								<Anchor point="RIGHT" x="-76" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Amount" inherits="GameFontHighlightSmall" justifyH="RIGHT">
							<Anchors>
								<Anchor point="RIGHT" x="-4" y="0"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</StatusBar>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>
</Ui>
