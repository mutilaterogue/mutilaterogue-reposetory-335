<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<Script file="DamageMeterSourceWindow.lua"/>

	<Frame name="DamageMeterSourceWindow" mixin="DamageMeterSourceWindowMixin" parent="UIParent" movable="true" enableMouse="true" hidden="true">
		<Size x="240" y="200"/>
		<Anchors>
			<Anchor point="TOPRIGHT" relativeTo="DamageMeterSessionWindow" relativePoint="TOPLEFT" x="-4" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="damagemeters-background" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="HeaderBar" atlas="ui-damagemeters-header-bar">
					<Size x="0" y="24"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="TOPRIGHT" x="-2" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Title" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" x="10" y="-8"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollFrame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT" x="6" y="-28"/>
					<Anchor point="BOTTOMRIGHT" x="-18" y="6"/>
				</Anchors>
			</ScrollFrame>
			<Frame parentKey="ScrollBar" inherits="MinimalScrollBar"/>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="2" y="2"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnDragStart>self:StartMoving();</OnDragStart>
			<OnDragStop>self:StopMovingOrSizing();</OnDragStop>
		</Scripts>
	</Frame>
</Ui>
