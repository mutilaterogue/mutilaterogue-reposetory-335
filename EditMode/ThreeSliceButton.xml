<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\UI.xsd">
	<!-- The retail ThreeSliceButtonTemplate / UIPanelButtonTemplate (128-RedButton) for 3.3.5 (ThreeSliceButton.lua).
	     Included by EditModeCore.xml; usable by any frame after it in FrameXML.toc. -->
	<Script file="ThreeSliceButton.lua"/>

	<Button name="ThreeSliceButtonTemplate" virtual="true">
		<Size x="20" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentLeft" parentKey="Left">
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRight" parentKey="Right">
					<Anchors>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentCenter" parentKey="Center" horizTile="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				ThreeSliceButton_OnLoad(self);
				ThreeSliceButton_HookState(self);
			</OnLoad>
			<OnMouseDown function="ThreeSliceButton_OnMouseDown"/>
			<OnMouseUp function="ThreeSliceButton_OnMouseUp"/>
			<OnShow>
				self:UpdateButton();
			</OnShow>
			<OnSizeChanged>
				self:UpdateScale();
			</OnSizeChanged>
		</Scripts>
	</Button>

	<!-- the retail red panel button: text in the middle, a step down when pressed -->
	<Button name="UIPanelButtonRetailTemplate" inherits="ThreeSliceButtonTemplate" virtual="true">
		<Size x="40" y="22"/>
		<ButtonText name="$parentText" parentKey="Text">
			<Anchors>
				<Anchor point="CENTER" x="0" y="1"/>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
		<PushedTextOffset x="1" y="-1"/>
		<HighlightTexture atlas="128-RedButton-Highlight" alphaMode="ADD"/>
	</Button>
</Ui>
