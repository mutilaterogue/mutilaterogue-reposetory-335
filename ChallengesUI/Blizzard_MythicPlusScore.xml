<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Mythic+ rating of other players and the season leaderboard (Blizzard_MythicPlusScore.lua) -->
	<Script file="Blizzard_MythicPlusScore.lua"/>

	<Frame name="ChallengesLeaderboardRowTemplate" virtual="true">
		<Size x="0" y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.05"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Rank" inherits="GameFontNormal" justifyH="RIGHT">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="0" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Name" inherits="GameFontHighlight" justifyH="LEFT">
					<Size x="130" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="32" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Level" inherits="GameFontHighlight" justifyH="CENTER">
					<Size x="40" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="166" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Time" inherits="GameFontHighlight" justifyH="CENTER">
					<Size x="60" y="22"/>
					<Anchors>
						<Anchor point="LEFT" x="210" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Score" inherits="GameFontHighlight" justifyH="RIGHT">
					<Size x="50" y="22"/>
					<Anchors>
						<Anchor point="RIGHT" x="-4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="ChallengesLeaderboardFrame" inherits="RetailPortraitFrameTemplate" toplevel="true" parent="UIParent" enableMouse="true" movable="true" hidden="true">
		<Size x="360" y="320"/>
		<Anchors>
			<Anchor point="TOPLEFT" x="600" y="-116"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Empty" inherits="GameFontDisable" text="NONE" hidden="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>ChallengesLeaderboard_OnLoad(self);</OnLoad>
			<OnDragStart>self:StartMoving();</OnDragStart>
			<OnDragStop>self:StopMovingOrSizing();</OnDragStop>
		</Scripts>
	</Frame>
</Ui>
