				</Texture>
				<Texture parentKey="Shockwave" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-Shockwave" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="60"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Shockwave2" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-Shockwave" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="60"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRunesLarge" parentKey="RunesLarge" alpha="0.15" atlas="ChallengeMode-Runes-Large">
					<Size x="196" y="196"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture parentKey="GlowBurstLarge" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-GlowBurstLarge" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRunesLarge" x="-1" y="-3"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RunesSmall" alpha="0.15" atlas="ChallengeMode-Runes-Small">
					<Size x="125" y="125"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture parentKey="GlowBurstSmall" alpha="0" atlas="ChallengeMode-Runes-GlowBurstLarge" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="60"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<Texture name="$parentSlotBG" parentKey="SlotBG" atlas="ChallengeMode-KeystoneSlotBG" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRuneCircleT" parentKey="RuneCircleT" alpha="0" atlas="ChallengeMode-Runes-CircleGlow">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="0" y="126"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRuneCircleR" parentKey="RuneCircleR" alpha="0" atlas="ChallengeMode-Runes-CircleGlow">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="118" y="40"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRuneCircleBR" parentKey="RuneCircleBR" alpha="0" atlas="ChallengeMode-Runes-CircleGlow">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="73" y="-98"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRuneCircleBL" parentKey="RuneCircleBL" alpha="0" atlas="ChallengeMode-Runes-CircleGlow">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="-73" y="-98"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRuneCircleL" parentKey="RuneCircleL" alpha="0" atlas="ChallengeMode-Runes-CircleGlow">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="-118" y="40"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="KeystoneFrame" atlas="ChallengeMode-KeystoneSlotFrame" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RuneT" alpha="0" atlas="ChallengeMode-Runes-T-Glow">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneCircleT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RuneR" alpha="0" atlas="ChallengeMode-Runes-R-Glow">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneCircleR" x="-1" y="0"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RuneBR" alpha="0" atlas="ChallengeMode-Runes-BR-Glow">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneCircleBR" x="-1" y="0"/>
