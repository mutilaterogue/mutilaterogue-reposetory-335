				</Texture>
				<Texture parentKey="RuneBL" alpha="0" atlas="ChallengeMode-Runes-BL-Glow">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneCircleBL" x="-1" y="0"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RuneL" alpha="0" atlas="ChallengeMode-Runes-L-Glow">
