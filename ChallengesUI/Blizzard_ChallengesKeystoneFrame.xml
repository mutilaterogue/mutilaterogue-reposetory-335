				</Texture>
				<Texture parentKey="LargeRuneGlow" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-GlowLarge">
					<Size x="198" y="199"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SmallRuneGlow" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-GlowSmall">
					<Size x="129" y="129"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="4">
				<Texture parentKey="KeystoneSlotGlow" alpha="0" alphaMode="ADD" atlas="ChallengeMode-KeystoneSlotFrameGlow" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="60"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-8" y="-9"/>
				</Anchors>
				<Scripts>
					<OnClick>
						self:GetParent():Hide();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentStartButton" parentKey="StartButton" inherits="UIPanelButtonTemplate" text="CHALLENGE_MODE_START_CHALLENGE">
				<Size x="120" y="24"/>
				<Anchors>
					<Anchor point="BOTTOM" x="0" y="34"/>
				</Anchors>
				<Scripts>
					<OnShow>
						self:SetWidth(self:GetTextWidth() + 60);
					</OnShow>
					<OnClick>
						ChallengesKeystoneFrame_StartChallengeMode(self:GetParent());
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentKeystoneSlot" parentKey="KeystoneSlot" enableMouse="true">
				<Size x="48" y="48"/>
				<Anchors>
					<Anchor point="CENTER" relativeTo="$parentSlotBG"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY" textureSubLevel="2">
						<Texture parentKey="Texture" setAllPoints="true"/>
						<MaskTexture parentKey="CircleMask" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
							<Anchors>
								<Anchor point="TOPLEFT" x="4" y="-4"/>
								<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
							</Anchors>
							<MaskedTextures>
								<MaskedTexture childKey="Texture"/>
							</MaskedTextures>
						</MaskTexture>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad function="ChallengesKeystoneSlot_OnLoad"/>
					<OnEnter function="ChallengesKeystoneSlot_OnEnter"/>
					<OnLeave function="GameTooltip_Hide"/>
					<OnReceiveDrag function="ChallengesKeystoneSlot_OnReceiveDrag"/>
					<OnDragStart function="ChallengesKeystoneSlot_OnDragStart"/>
					<OnClick function="ChallengesKeystoneSlot_OnClick"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad function="ChallengesKeystoneFrame_OnLoad"/>
			<OnShow function="ChallengesKeystoneFrame_OnShow"/>
			<OnHide function="ChallengesKeystoneFrame_OnHide"/>
			<OnMouseUp function="ChallengesKeystoneFrame_OnMouseUp"/>
			<OnUpdate function="ChallengesKeystoneFrame_OnUpdate"/>
		</Scripts>
	</Frame>
</Ui>
