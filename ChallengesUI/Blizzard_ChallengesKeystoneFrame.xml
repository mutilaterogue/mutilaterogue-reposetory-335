<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Font of Power: retail ChallengesKeystoneFrame (Blizzard_ChallengesUI.xml) 1:1 for 3.3.5.
	     relativeKey -> $parent names, MaskTexture through XMLExt (WotLKExtensions), the XML AnimationGroups (fromAlpha/toAlpha) are
	     played in Lua (Blizzard_ChallengesKeystoneFrame.lua). Server: server/mythic_plus.cpp. -->
	<Script file="Blizzard_ChallengesKeystoneFrame.lua"/>

	<!-- retail ChallengesKeystoneFrameAffixTemplate -->
	<Frame name="ChallengesKeystoneFrameAffixTemplate" enableMouse="true" virtual="true">
		<Size x="52" y="52"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentBorder" parentKey="Border" atlas="ChallengeMode-AffixRing-Lg" setAllPoints="true"/>
				<FontString parentKey="Percent" inherits="GameFontNormalLarge" hidden="true">
					<Anchors>
						<Anchor point="BOTTOM" relativeTo="$parentBorder" x="0" y="-4"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentPortrait" parentKey="Portrait">
					<Size x="50" y="50"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentBorder"/>
					</Anchors>
				</Texture>
				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentPortrait"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentPortrait"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Portrait"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter function="ChallengesKeystoneFrameAffix_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Frame>

	<Frame name="ChallengesKeystoneFrame" hidden="true" parent="UIParent" frameStrata="HIGH" enableMouse="true">
		<Size x="398" y="548"/>
		<Anchors>
			<Anchor point="CENTER" x="0" y="40"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture atlas="ChallengeMode-KeystoneFrame" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentRuneBG" parentKey="RuneBG" atlas="ChallengeMode-RuneBG">
					<Size x="360" y="360"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="60"/>
					</Anchors>
				</Texture>
				<Texture name="$parentInstructionBackground" parentKey="InstructionBackground">
					<Size x="374" y="60"/>
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="80"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0.8"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture parentKey="BgBurst2" alpha="0" alphaMode="ADD" atlas="ChallengeMode-Runes-BackgroundBurst" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="61"/>
					</Anchors>
				</Texture>
				<Texture name="$parentDivider" parentKey="Divider" atlas="ChallengeMode-ThinDivider" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOM" relativeTo="$parentInstructionBackground" relativePoint="TOP"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="$parentDungeonName" parentKey="DungeonName" inherits="GameFontNormalHuge" hidden="true">
					<Size x="350" y="0"/>
					<Anchors>
						<Anchor point="BOTTOM" relativeTo="$parentDivider" relativePoint="TOP" x="0" y="4"/>
					</Anchors>
				</FontString>
				<FontString parentKey="PowerLevel" inherits="GameFontNormalHuge" hidden="true">
					<Anchors>
						<Anchor point="TOP" x="0" y="-30"/>
					</Anchors>
				</FontString>
				<FontString parentKey="TimeLimit" inherits="GameFontHighlightLarge" hidden="true">
					<Anchors>
						<Anchor point="TOP" relativeTo="$parentDivider" relativePoint="TOP" x="0" y="-6"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Instructions" inherits="GameFontHighlightLarge" text="CHALLENGE_MODE_INSERT_KEYSTONE">
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentInstructionBackground"/>
					</Anchors>
				</FontString>
				<Texture parentKey="PentagonLines" alpha="0" atlas="ChallengeMode-Runes-LineGlow" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentRuneBG" x="0" y="6"/>
					</Anchors>
				</Texture>
				<Texture parentKey="LargeCircleGlow" alpha="0" atlas="ChallengeMode-Runes-InnerCircleGlow" useAtlasSize="true">
