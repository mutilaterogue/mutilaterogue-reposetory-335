<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\UI.xsd">
	<!-- ретейл: ArcheologyDigsiteProgressBar - полоса находок места раскопок и кнопка «Исследование» -->
	<Script file="Blizzard_ArchaeologyDigsite.lua"/>

	<Frame name="ArchaeologyDigsiteFrame" parent="UIParent" hidden="true" frameStrata="MEDIUM">
		<Size x="260" y="46"/>
		<Anchors>
			<Anchor point="BOTTOM" x="0" y="160"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentTitle" parentKey="Title" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP" x="-18" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<StatusBar name="$parentBar" parentKey="Bar" minValue="0" maxValue="3" defaultValue="0">
				<Size x="200" y="14"/>
				<Anchors>
					<Anchor point="BOTTOM" x="-18" y="6"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.6"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<Texture file="Interface\PaperDollInfoFrame\UI-Character-Skills-BarBorder">
							<Size x="210" y="26"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
						<FontString parentKey="Text" inherits="GameFontHighlightSmall">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<BarTexture file="Interface\PaperDollInfoFrame\UI-Character-Skills-Bar"/>
				<BarColor r="0.8" g="0.55" b="0.2"/>
			</StatusBar>
			<!-- направление к находке после «Исследовать» (вместо модели телескопа): цвет - как далеко, стрелка - куда идти -->
			<Frame name="$parentSurvey" parentKey="Survey" hidden="true">
				<Size x="40" y="40"/>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentBar" relativePoint="LEFT" x="-10" y="6"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Light" file="Interface\Cooldown\star4" alphaMode="ADD">
							<Size x="48" y="48"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<!-- стрелка в текстуре смотрит вниз, поворот - в Lua -->
						<Texture parentKey="Arrow" file="Interface\Buttons\UI-MicroStream-Yellow">
							<Size x="32" y="32"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnUpdate function="ArchaeologySurvey_OnUpdate"/>
				</Scripts>
			</Frame>
			<!-- «Исследовать» (80451) - защищённая кнопка заклинания -->
			<Button name="$parentSurveyButton" parentKey="SurveyButton" inherits="SecureActionButtonTemplate">
				<Size x="36" y="36"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentBar" relativePoint="RIGHT" x="10" y="6"/>
				</Anchors>
				<NormalTexture file="Interface\Icons\INV_Misc_Shovel_01"/>
				<PushedTexture file="Interface\Icons\INV_Misc_Shovel_01"/>
				<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
				<Scripts>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText(ARCHAEOLOGY_SURVEY);
						GameTooltip:AddLine("Показывает направление к ближайшей находке. Также: /cast Исследовать", 1, 1, 1, true);
						GameTooltip:Show();
					</OnEnter>
					<OnLeave function="GameTooltip_Hide"/>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
