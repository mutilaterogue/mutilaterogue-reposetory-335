The 3.3.5 talents can't change during a keystone run (mythic_plus.cpp: MythicPlus_TalentsLocked sets the hook).
Apply by hand (TrinityCore 3.3.5 context): learning a talent and switching the dual spec are refused while the hook says so.

--- a/src/server/game/Entities/Player/Player.h
+++ b/src/server/game/Entities/Player/Player.h
@@ near void LearnTalent(uint32 talentId, uint32 talentRank);
         void LearnTalent(uint32 talentId, uint32 talentRank);
+        // mythic_plus.cpp: true while a keystone run of the player's instance is going
+        typedef bool (*TalentsLockedHook)(Player const* player);
+        static TalentsLockedHook s_talentsLockedHook;

--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ before void Player::LearnTalent(uint32 talentId, uint32 talentRank)
+Player::TalentsLockedHook Player::s_talentsLockedHook = nullptr;
+
 void Player::LearnTalent(uint32 talentId, uint32 talentRank)
 {
+    if (s_talentsLockedHook && s_talentsLockedHook(this))
+        return;
+
     uint32 CurTalentPoints = GetFreeTalentPoints();
     ...

@@ at the start of the dual spec switch (Player::ActivateSpec / ActivateTalentGroup, whichever your core has)
 void Player::ActivateSpec(uint8 spec)
 {
+    if (s_talentsLockedHook && s_talentsLockedHook(this))
+        return;
+
     if (GetActiveSpec() == spec)
         return;
     ...

