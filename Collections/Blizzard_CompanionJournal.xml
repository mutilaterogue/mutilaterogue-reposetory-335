<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\UI.xsd">
	<Script file="Blizzard_CompanionJournal.lua"/>

	<!--
		Вкладка компаньонов (раскладка MountJournal ретейла):
		  сверху - счётчик "Всего" и кнопка "Случайное избранное";
		  слева  - поиск, "Фильтр", список (строки - CollectionsCompanionListButtonTemplate);
		  справа - фон, иконка/имя/источник/описание и 3D-модель;
		  снизу  - кнопка "Призвать".
		KeyValues экземпляра: companionType (MOUNT/CRITTER) и тексты - см. Mounts\ и Pets\.
	-->
	<Frame name="CollectionsCompanionJournalTemplate" mixin="CollectionsCompanionJournalMixin" virtual="true">
		<Frames>
			<Frame name="$parentCount" parentKey="Count" inherits="InsetFrameTemplate">
				<Size x="130" y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="70" y="-35"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parentValue" parentKey="Value" inherits="GameFontHighlightSmall" justifyH="RIGHT">
							<Anchors>
								<Anchor point="RIGHT" x="-10" y="0"/>
							</Anchors>
						</FontString>
						<FontString name="$parentLabel" parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT" text="Всего:">
							<Anchors>
								<Anchor point="LEFT" x="10" y="0"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame name="$parentLeftInset" parentKey="LeftInset" inherits="InsetFrameTemplate">
				<Size x="260" y="496"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-60"/>
					<Anchor point="BOTTOMLEFT" x="4" y="26"/>
				</Anchors>
			</Frame>

			<Frame name="$parentRightInset" parentKey="RightInset" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-6" y="-60"/>
					<Anchor point="BOTTOMLEFT" relativeTo="$parentLeftInset" relativePoint="BOTTOMRIGHT" x="20" y="0"/>
				</Anchors>
			</Frame>

			<EditBox name="$parentSearchBox" parentKey="SearchBox" inherits="SearchBoxTemplate" letters="40">
				<Size x="145" y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentLeftInset" x="15" y="-9"/>
				</Anchors>
			</EditBox>

			<!-- прокрутка списка: полоса в своей колонке справа, строки - в ListFrame -->
			<ScrollFrame name="$parentListScrollFrame" parentKey="ListScrollFrame" inherits="FauxScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentLeftInset" x="0" y="-36"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentLeftInset" x="-26" y="4"/>
				</Anchors>
			</ScrollFrame>
			<Frame name="$parentListFrame" parentKey="ListFrame" enableMouseWheel="true">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentListScrollFrame"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentListScrollFrame"/>
				</Anchors>
			</Frame>

			<Button name="$parentFilterDropdown" parentKey="FilterDropdown" inherits="WowStyle1FilterDropdownTemplate">
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="$parentLeftInset" x="-5" y="-9"/>
				</Anchors>
			</Button>

			<Frame name="$parentDisplay" parentKey="Display">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentRightInset" x="3" y="-3"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentRightInset" x="-3" y="3"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
					</Layer>
					<Layer level="ARTWORK">
						<Texture name="$parentIcon" parentKey="Icon">
							<Size x="38" y="38"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="26" y="-26"/>
							</Anchors>
						</Texture>
						<FontString name="$parentName" parentKey="Name" inherits="GameFontHighlightLarge" justifyH="LEFT">
							<Size x="300" y="35"/>
							<Anchors>
								<Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="10" y="0"/>
							</Anchors>
						</FontString>
						<FontString name="$parentSource" parentKey="Source" inherits="GameFontHighlight" justifyH="LEFT">
							<Size x="345" y="0"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="BOTTOMLEFT" x="0" y="-6"/>
							</Anchors>
						</FontString>
						<FontString name="$parentLore" parentKey="Lore" inherits="GameFontNormal" justifyH="LEFT">
							<Size x="345" y="0"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentSource" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
							</Anchors>
						</FontString>
						<FontString name="$parentEmptyText" parentKey="EmptyText" inherits="GameFontHighlightLarge" justifyH="CENTER" hidden="true">
							<Size x="280" y="80"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</FontString>
						<FontString name="$parentRotateHint" parentKey="RotateHint" inherits="GameFontDisableSmall" text="Потяните мышью, чтобы повернуть; колесо - приблизить">
							<Anchors>
								<Anchor point="BOTTOM" x="0" y="10"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<!-- ModelScene в 3.3.5 нет: обычная 3D-модель -->
					<DressUpModel name="$parentModel" parentKey="Model" enableMouse="true" enableMouseWheel="true">
						<Anchors>
							<Anchor point="TOPLEFT" x="0" y="-120"/>
							<Anchor point="BOTTOMRIGHT" x="0" y="30"/>
						</Anchors>
					</DressUpModel>
				</Frames>
			</Frame>

			<Button name="$parentSummonButton" parentKey="SummonButton" inherits="MagicButtonTemplate">
				<Size x="140" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="4" y="4"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnShow method="Refresh"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
