<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\UI.xsd">
	<Script file="Blizzard_PetCollection.lua"/>

	<Frame name="PetJournal" parent="CollectionsJournal" setAllPoints="true" inherits="CollectionsCompanionJournalTemplate" hidden="true">
		<Frames>
			<!-- как в ретейле: заклинание "Призвать случайного избранного питомца" (243819).
			     Заклинание добавляется на сервере/в DBC под тем же ID.
			     В ретейле x=-159: справа стоит кнопка лечения боевых питомцев, в 3.3.5 её нет. -->
			<Frame name="$parentSummonRandomPetSpellFrame" parentKey="SummonRandomPetSpellFrame" inherits="UIPanelSpellButtonFrameTemplate" mixin="PetJournalSummonRandomPetSpellFrameMixin">
				<Size x="166" y="33"/>
				<KeyValues>
					<KeyValue key="spellID" value="243819" type="number"/>
					<KeyValue key="labelText" value="PET_JOURNAL_SUMMON_RANDOM_FAVORITE_PET" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-8" y="-25"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad function="PetJournal_OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
