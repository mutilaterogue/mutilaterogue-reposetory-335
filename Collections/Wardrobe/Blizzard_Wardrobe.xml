<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\UI.xsd">
	<!-- Вкладка «Внешний вид» (ретейл WardrobeCollectionFrame, вкладка «Предметы») для 3.3.5.
	     Данные - сервер (server\appearance_collection.cpp), опкоды APPEAR_*. -->
	<Script file="Blizzard_Wardrobe.lua"/>

	<DressUpModel name="WardrobeItemsModelTemplate" virtual="true" enableMouse="true">
		<Size x="78" y="104"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture setAllPoints="true">
					<Color r="0" g="0" b="0"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="-1">
				<Texture name="$parentBorder" parentKey="Border">
					<Size x="96" y="124"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="-3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelected" parentKey="Selected" alphaMode="ADD" hidden="true">
					<Size x="96" y="124"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture name="$parentHighlight" parentKey="Highlight" alphaMode="ADD">
					<Size x="96" y="124"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="WardrobeItemsModel_OnLoad"/>
			<OnMouseDown function="WardrobeItemsModel_OnMouseDown"/>
			<OnEnter function="WardrobeItemsModel_OnEnter"/>
			<OnLeave function="WardrobeItemsModel_OnLeave"/>
		</Scripts>
	</DressUpModel>

	<Button name="WardrobeSlotButtonTemplate" virtual="true">
		<Size x="31" y="31"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelectedTexture" parentKey="SelectedTexture" hidden="true">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
		<Scripts>
			<OnClick function="WardrobeSlotButton_OnClick"/>
			<OnEnter function="WardrobeSlotButton_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<Frame name="WardrobeCollectionFrame" parent="CollectionsJournal" setAllPoints="true" hidden="true">
		<Frames>
			<Frame name="$parentInset" parentKey="Inset" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-60"/>
