						</FontString>
					</Layer>
				</Layers>
			</StatusBar>

			<Button name="$parentClassDropdown" parentKey="ClassDropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="150" y="25"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="68" y="-31"/>
				</Anchors>
			</Button>

			<EditBox name="$parentSearchBox" parentKey="SearchBox" inherits="SearchBoxTemplate" letters="40">
