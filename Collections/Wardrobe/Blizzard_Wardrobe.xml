				</Anchors>
			</Frame>

			<StatusBar name="$parentProgressBar" parentKey="ProgressBar" minValue="0" maxValue="1" defaultValue="0" inherits="CollectionsProgressBarTemplate">
				<Size x="196" y="13"/>
				<Anchors>
					<Anchor point="TOP" x="0" y="-38"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightSmall">
							<Anchors>
								<Anchor point="CENTER" x="0" y="1"/>
