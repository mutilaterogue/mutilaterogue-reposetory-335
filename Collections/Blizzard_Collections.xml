<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\UI.xsd">
	<Script file="Blizzard_Collections.lua"/>

	<!-- Окно коллекций. Вкладки внизу - TabSystem (TabSystem\TabSystemTemplates.xml). -->
	<Frame name="CollectionsJournal" inherits="ButtonFrameTemplate" mixin="TabSystemOwnerMixin" toplevel="true" enableMouse="true" parent="UIParent" hidden="true">
		<Size x="703" y="606"/>
		<Frames>
			<Frame name="$parentTabSystem" parentKey="TabSystem" inherits="TabSystemTemplate">
				<KeyValues>
					<KeyValue key="minTabWidth" value="110" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="22" y="2"/>
				</Anchors>
			</Frame>
		</Frames>
		<!-- OnLoad не задаём: он перебил бы OnLoad ButtonFrameTemplate; CollectionsJournal_OnLoad
		     вызывается из Blizzard_CollectionsInit.lua -->
		<Scripts>
			<OnShow function="CollectionsJournal_OnShow"/>
			<OnHide function="CollectionsJournal_OnHide"/>
		</Scripts>
	</Frame>
</Ui>
