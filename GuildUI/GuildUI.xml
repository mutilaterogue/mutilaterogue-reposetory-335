<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\UI.xsd">
	<!--
		The guild window (retail 12.1.5 Blizzard_Communities: CommunitiesFrame, GuildRoster, GuildInfo, GuildPerks,
		ClubFinder) for 3.3.5a. Replaces the Friends frame's guild tab.
	-->
	<Script file="GuildUI.lua"/>
	<Script file="GuildFinder.lua"/>
	<Script file="GuildRewards.lua"/>
	<Script file="GuildNews.lua"/>

	<!-- ============================================================ templates -->

	<!-- the retail side tab (CommunitiesFrameTabTemplate) -->
	<CheckButton name="GuildUITabTemplate" virtual="true">
