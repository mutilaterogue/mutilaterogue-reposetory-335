					<!-- recruitment only: listed, the comment -->
					<CheckButton name="$parentListed" parentKey="Listed" inherits="GuildUICheckTemplate">
						<Anchors><Anchor point="TOPLEFT" x="4" y="-42"/></Anchors>
					</CheckButton>
					<EditBox name="$parentComment" parentKey="Comment" inherits="InputBoxTemplate" letters="255" autoFocus="false">
						<Size x="230" y="20"/>
						<Anchors><Anchor point="TOPLEFT" x="250" y="-43"/></Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<FontString inherits="GameFontNormalSmall" text="Комментарий:" justifyH="RIGHT">
									<Anchors>
										<Anchor point="RIGHT" relativePoint="LEFT" x="-10" y="0"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnEscapePressed>
								self:ClearFocus();
							</OnEscapePressed>
							<OnEnterPressed>
								self:ClearFocus();
							</OnEnterPressed>
						</Scripts>
					</EditBox>
					<Button name="$parentMode" parentKey="Mode" inherits="UIPanelButtonTemplate">
						<Size x="154" y="20"/>
						<Anchors><Anchor point="TOPRIGHT" x="-2" y="-46"/></Anchors>
						<Scripts>
							<OnClick function="GuildFinder_ToggleMode"/>
						</Scripts>
					</Button>
					<Frame name="$parentListBg" inherits="InsetFrameTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="0" y="-68"/>
							<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
						</Anchors>
					</Frame>
					<ScrollFrame name="$parentList" parentKey="List" inherits="GuildUIListTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="4" y="-72"/>
							<Anchor point="BOTTOMRIGHT" x="-26" y="4"/>
						</Anchors>
					</ScrollFrame>
				</Frames>
			</Frame>
			<!-- the bottom bar (retail: InviteButton under the list, GuildControlButton / GuildRecruitmentButton on the right) -->
			<Button name="$parentInviteButton" parentKey="InviteButton" inherits="UIPanelButtonTemplate" text="Пригласить в гильдию">
				<Size x="166" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="6" y="4"/>
				</Anchors>
				<Scripts>
					<OnClick>
						StaticPopup_Show("ADD_GUILDMEMBER");
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentControlButton" parentKey="ControlButton" inherits="UIPanelButtonTemplate" text="Управление гильдией">
				<Size x="150" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-8" y="4"/>
				</Anchors>
				<Scripts>
					<OnClick function="GuildUI_ToggleControl"/>
				</Scripts>
			</Button>
			<Button name="$parentRecruitmentButton" parentKey="RecruitmentButton" inherits="UIPanelButtonTemplate" text="Набор в гильдию">
				<Size x="150" y="22"/>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentControlButton" relativePoint="LEFT" x="-2" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick function="GuildUI_ShowRecruitment"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad function="GuildUI_OnLoad"/>
			<OnEvent function="GuildUI_OnEvent"/>
			<OnShow function="GuildUI_OnShow"/>
			<OnHide function="GuildUI_OnHide"/>
			<OnMouseDown>
				self:StartMoving();
			</OnMouseDown>
			<OnMouseUp>
				self:StopMovingOrSizing();
			</OnMouseUp>
		</Scripts>
	</Frame>

	<!-- the MOTD / guild info editor (retail GuildTextEditFrame) -->
	<Frame name="GuildUITextEditFrame" parent="CommunitiesFrame" toplevel="true" frameStrata="DIALOG" enableMouse="true" hidden="true">
		<Size x="295" y="230"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="CommunitiesFrame" relativePoint="TOPRIGHT" x="40" y="-30"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" parentKey="Title" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP" x="0" y="-14"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollFrame name="$parentScroll" inherits="UIPanelScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="18" y="-36"/>
					<Anchor point="BOTTOMRIGHT" x="-36" y="44"/>
				</Anchors>
				<ScrollChild>
					<EditBox name="GuildUITextEditBox" multiLine="true" letters="500" autoFocus="false">
						<Size x="236" y="140"/>
						<FontString inherits="GameFontHighlightSmall"/>
						<Scripts>
							<OnEscapePressed>
								GuildUITextEditFrame:Hide();
							</OnEscapePressed>
							<OnTextChanged>
								ScrollingEdit_OnTextChanged(self, self:GetParent());
							</OnTextChanged>
							<OnCursorChanged function="ScrollingEdit_OnCursorChanged"/>
							<OnUpdate>
								ScrollingEdit_OnUpdate(self, elapsed, self:GetParent());
							</OnUpdate>
						</Scripts>
					</EditBox>
				</ScrollChild>
			</ScrollFrame>
			<Button name="$parentAccept" inherits="UIPanelButtonTemplate" text="ACCEPT">
				<Size x="90" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="22" y="16"/>
				</Anchors>
				<Scripts>
					<OnClick function="GuildUITextEdit_Accept"/>
				</Scripts>
			</Button>
			<Button name="$parentClose" inherits="UIPanelButtonTemplate" text="CLOSE">
				<Size x="90" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-22" y="16"/>
				</Anchors>
				<Scripts>
					<OnClick>
						GuildUITextEditFrame:Hide();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad function="GuildUIPopup_OnLoad"/>
		</Scripts>
	</Frame>

	<!-- the event log (retail GuildLogFrame) -->
	<Frame name="GuildUILogFrame" parent="CommunitiesFrame" toplevel="true" frameStrata="DIALOG" enableMouse="true" hidden="true">
		<Size x="384" y="432"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="CommunitiesFrame" relativePoint="TOPRIGHT" x="40" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" inherits="GameFontNormal" text="Журнал событий гильдии">
					<Anchors>
						<Anchor point="TOP" x="0" y="-14"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollingMessageFrame name="$parentText" parentKey="Text" fade="false" maxLines="200" insertMode="TOP" enableMouse="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="20" y="-38"/>
					<Anchor point="BOTTOMRIGHT" x="-20" y="46"/>
				</Anchors>
				<FontString inherits="GameFontHighlightSmall" justifyH="LEFT"/>
				<Scripts>
					<OnMouseWheel>
						if ( delta > 0 ) then self:ScrollUp(); else self:ScrollDown(); end
					</OnMouseWheel>
				</Scripts>
			</ScrollingMessageFrame>
			<Button name="$parentClose" inherits="UIPanelButtonTemplate" text="CLOSE">
				<Size x="90" y="22"/>
				<Anchors>
					<Anchor point="BOTTOM" x="0" y="16"/>
				</Anchors>
				<Scripts>
					<OnClick>
						GuildUILogFrame:Hide();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad function="GuildUIPopup_OnLoad"/>
			<OnShow>
				QueryGuildEventLog();
				GuildUILog_Update();
			</OnShow>
		</Scripts>
	</Frame>
	<!-- the guild news filters (retail GuildNewsFiltersFrame), next to the window -->
	<Frame name="GuildUINewsFiltersFrame" parent="CommunitiesFrame" toplevel="true" frameStrata="DIALOG" enableMouse="true" hidden="true">
		<Size x="230" y="210"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="CommunitiesFrame" relativePoint="TOPRIGHT" x="40" y="-30"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontNormal" text="Фильтры новостей гильдии">
					<Anchors>
						<Anchor point="TOPLEFT" x="16" y="-14"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentClose" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-2" y="-2"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad function="GuildNewsFilters_OnLoad"/>
			<OnShow function="GuildNewsFilters_OnShow"/>
		</Scripts>
	</Frame>
</Ui>
