<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\UI.xsd">
	<!-- Окно трансмогрификации (ретейл 12.x TransmogFrame, упрощено для 3.3.5):
	     слева образы, по центру персонаж со слотами, справа коллекция обликов выбранного слота.
	     В FrameXML.toc - после Collections\Collections.xml: Transmog\Blizzard_Transmog.xml -->
	<!-- порядок как в ретейле: общие данные, шаблоны, образы, само окно -->
	<Script file="Blizzard_TransmogShared.lua"/>
	<Include file="Blizzard_TransmogTemplates.xml"/>
	<Script file="Blizzard_TransmogOutfits.lua"/>
	<Script file="Blizzard_Transmog.lua"/>

	<Frame name="TransmogFrame" inherits="RetailPortraitFrameTemplate" parent="UIParent" toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" hidden="true" frameStrata="HIGH">
		<Size x="1200" y="720"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Scripts>
			<OnLoad function="TransmogFrame_OnLoad"/>
			<OnShow function="TransmogFrame_OnShow"/>
			<OnHide function="TransmogFrame_OnHide"/>
			<OnEvent function="TransmogFrame_OnEvent"/>
			<OnDragStart>self:StartMoving();</OnDragStart>
			<OnDragStop>self:StopMovingOrSizing();</OnDragStop>
		</Scripts>
	</Frame>
</Ui>
