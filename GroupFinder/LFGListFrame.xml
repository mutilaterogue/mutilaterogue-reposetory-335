						</Scripts>
					</ScrollFrame>
					<Button name="$parentBackButton" parentKey="BackButton" inherits="UIPanelButtonTemplate" text="BACK">
						<Size x="135" y="22"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" x="4" y="3"/>
						</Anchors>
						<Scripts>
							<OnClick function="LFGListFrame_ShowCategorySelection"/>
