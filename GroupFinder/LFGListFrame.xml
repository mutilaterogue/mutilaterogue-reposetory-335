			<Frame name="$parentCategorySelection" parentKey="CategorySelection" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parentLabel" parentKey="Label" inherits="GameFontNormalLarge" text="Заранее собранные группы">
							<Anchors>
								<Anchor point="TOP" x="0" y="-34"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="$parentStartGroupButton" parentKey="StartGroupButton" inherits="UIPanelButtonTemplate" text="Создать группу">
						<Size x="135" y="22"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" x="4" y="3"/>
						</Anchors>
						<Scripts>
							<OnClick function="LFGListStartGroup_OnClick"/>
						</Scripts>
					</Button>
					<Button name="$parentFindGroupButton" parentKey="FindGroupButton" inherits="UIPanelButtonTemplate" text="Найти группу">
