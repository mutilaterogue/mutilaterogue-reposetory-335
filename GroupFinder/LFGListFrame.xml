<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Premade Groups (retail Blizzard_GroupFinder\LFGList.xml) for the server's group finder (server/premade_groups.cpp):
	     the categories, the search, the group creation, the applicants of our listed group and the sign up dialog.
	     The data and C_LFGList: LFGList.lua. Shown inside PVEFrame (PVEFrame.lua, tab 1 section 3).
	     Retail controls: WowStyle1DropdownTemplate / WowStyle1FilterDropdownTemplate (SharedXML\Menu),
	     the common-search-border edit boxes, NineSlice "Dialog" for the sign up dialog.
	     Included by PVEFrame.xml before PVEFrame. -->
	<Script file="LFGList.lua"/>
	<Script file="LFGListFrame.lua"/>

	<!-- ======================== controls ======================== -->

	<!-- a one-line edit box: the retail common-search-border, the gray hint while empty (InputBoxInstructionsTemplate) -->
	<EditBox name="LFGListEditBoxTemplate" autoFocus="false" virtual="true">
		<Size x="270" y="22"/>
		<TextInsets left="8" right="8" top="0" bottom="0"/>
		<FontString inherits="ChatFontNormal"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentLeft" parentKey="Left" atlas="common-search-border-left">
					<Size x="8" y="22"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRight" parentKey="Right" atlas="common-search-border-right">
					<Size x="8" y="22"/>
					<Anchors>
						<Anchor point="RIGHT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentMiddle" parentKey="Middle" atlas="common-search-border-middle">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentInstructions" parentKey="Instructions" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="8" y="0"/>
						<Anchor point="RIGHT" x="-8" y="0"/>
					</Anchors>
					<Color r="0.35" g="0.35" b="0.35"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnTextChanged function="LFGListEditBox_OnTextChanged"/>
			<OnEscapePressed function="EditBox_ClearFocus"/>
			<OnEnterPressed function="EditBox_ClearFocus"/>
			<OnEditFocusGained function="EditBox_HighlightText"/>
			<OnEditFocusLost function="EditBox_ClearHighlight"/>
		</Scripts>
	</EditBox>

	<!-- the search box: the magnifying glass in front of the text, the clear button -->
	<EditBox name="LFGListSearchBoxTemplate" inherits="LFGListEditBoxTemplate" virtual="true">
		<TextInsets left="22" right="20" top="0" bottom="0"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentSearchIcon" parentKey="SearchIcon" atlas="common-search-magnifyingglass">
					<Size x="10" y="10"/>
					<Anchors>
						<Anchor point="LEFT" x="8" y="-1"/>
					</Anchors>
					<Color r="0.7" g="0.7" b="0.7"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentClearButton" parentKey="ClearButton" hidden="true">
				<Size x="17" y="17"/>
				<Anchors>
					<Anchor point="RIGHT" x="-3" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parentTexture" parentKey="Texture" atlas="common-search-clearbutton" alpha="0.5">
							<Size x="10" y="10"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>self.Texture:SetAlpha(1);</OnEnter>
					<OnLeave>self.Texture:SetAlpha(0.5);</OnLeave>
					<OnClick function="LFGListSearchBoxClear_OnClick"/>
				</Scripts>
			</Button>
		</Frames>
	</EditBox>

	<!-- a multi-line note: a dark box with the border, the edit box inside (retail InputScrollFrameTemplate) -->
	<Frame name="LFGListMultiLineEditBoxTemplate" virtual="true">
		<Size x="270" y="48"/>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<BackgroundInsets left="3" right="3" top="3" bottom="3"/>
			<TileSize val="16"/>
			<EdgeSize val="12"/>
		</Backdrop>
		<Frames>
			<EditBox name="$parentEditBox" parentKey="EditBox" multiLine="true" autoFocus="false" letters="255">
				<Anchors>
					<Anchor point="TOPLEFT" x="7" y="-6"/>
					<Anchor point="BOTTOMRIGHT" x="-7" y="6"/>
				</Anchors>
				<FontString inherits="GameFontHighlightSmall"/>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parentInstructions" parentKey="Instructions" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="TOPRIGHT"/>
							</Anchors>
							<Color r="0.35" g="0.35" b="0.35"/>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnTextChanged function="LFGListEditBox_OnTextChanged"/>
					<OnEscapePressed function="EditBox_ClearFocus"/>
				</Scripts>
			</EditBox>
		</Frames>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.8);
				self:SetBackdropBorderColor(0.4, 0.4, 0.4);
			</OnLoad>
			<OnMouseDown>self.EditBox:SetFocus();</OnMouseDown>
		</Scripts>
	</Frame>

	<!-- a labeled check box -->
	<CheckButton name="LFGListCheckButtonTemplate" inherits="UICheckButtonTemplate" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentLabel" parentKey="Label" inherits="GameFontHighlightSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="2" y="1"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- ======================== list rows ======================== -->

	<!-- a category: its art, the cover, the name (retail LFGListCategoryTemplate) -->
	<Button name="LFGListCategoryTemplate" virtual="true">
		<Size x="300" y="46"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="290" y="36"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentCover" parentKey="Cover" atlas="groupfinder-button-cover" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelected" parentKey="SelectedTexture" atlas="groupfinder-button-select" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<FontString name="$parentLabel" parentKey="Label" inherits="GameFontNormalLarge">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				LFGList_AddHighlight(self, "groupfinder-button-highlight", 292, 37);
			</OnLoad>
			<OnClick function="LFGListCategoryButton_OnClick"/>
		</Scripts>
	</Button>

	<!-- a role count of a raid group: the icon and the number (retail LFGListGroupDataDisplayRoleCount) -->
	<Frame name="LFGListRoleCountTemplate" virtual="true">
		<Size x="30" y="18"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
				<FontString name="$parentCount" parentKey="Count" inherits="GameFontHighlightSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- one member slot of a party (retail LFGListGroupDataDisplayEnumerate): his role, the leader's crown, or an empty slot -->
	<Frame name="LFGListMemberSlotTemplate" virtual="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentLeader" parentKey="Leader" atlas="groupfinder-icon-leader" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="BOTTOM" relativePoint="TOP" x="0" y="-3"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- a search result (retail LFGListSearchEntryTemplate) -->
	<Button name="LFGListSearchEntryTemplate" virtual="true">
		<Size x="296" y="36"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentResultBG" parentKey="ResultBG" alpha="0.4" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentName" parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size x="170" y="14"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-4"/>
					</Anchors>
				</FontString>
				<FontString name="$parentActivityName" parentKey="ActivityName" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
					<Size x="170" y="12"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
					</Anchors>
					<Color r="0.5" g="0.5" b="0.5"/>
				</FontString>
				<Texture name="$parentVoiceChat" parentKey="VoiceChat" atlas="groupfinder-icon-voice" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="RIGHT" x="-108" y="0"/>
					</Anchors>
				</Texture>
				<FontString name="$parentPendingLabel" parentKey="PendingLabel" inherits="GameFontGreenSmall" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="TOPRIGHT" x="-30" y="-6"/>
					</Anchors>
				</FontString>
				<FontString name="$parentExpirationTime" parentKey="ExpirationTime" inherits="GameFontHighlightSmall" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="TOPRIGHT" relativeTo="$parentPendingLabel" relativePoint="BOTTOMRIGHT" x="0" y="-3"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelected" parentKey="Selected" atlas="groupfinder-highlightbar-yellow" alpha="0.6" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- the members: five slots of a party, the role counts of a raid -->
			<Frame name="$parentDataDisplay" parentKey="DataDisplay">
				<Size x="100" y="20"/>
				<Anchors>
					<Anchor point="RIGHT" x="-4" y="-2"/>
				</Anchors>
				<Frames>
					<Frame name="$parentSlot5" parentKey="Slot5" inherits="LFGListMemberSlotTemplate">
						<Anchors>
							<Anchor point="RIGHT"/>
						</Anchors>
					</Frame>
					<Frame name="$parentSlot4" parentKey="Slot4" inherits="LFGListMemberSlotTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentSlot5" relativePoint="LEFT" x="-1" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentSlot3" parentKey="Slot3" inherits="LFGListMemberSlotTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentSlot4" relativePoint="LEFT" x="-1" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentSlot2" parentKey="Slot2" inherits="LFGListMemberSlotTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentSlot3" relativePoint="LEFT" x="-1" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentSlot1" parentKey="Slot1" inherits="LFGListMemberSlotTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentSlot2" relativePoint="LEFT" x="-1" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentDamager" parentKey="Damager" inherits="LFGListRoleCountTemplate">
						<Anchors>
							<Anchor point="RIGHT" x="0" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentHealer" parentKey="Healer" inherits="LFGListRoleCountTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentDamager" relativePoint="LEFT" x="0" y="0"/>
						</Anchors>
					</Frame>
					<Frame name="$parentTank" parentKey="Tank" inherits="LFGListRoleCountTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentHealer" relativePoint="LEFT" x="0" y="0"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
			<!-- cancel our application -->
			<Button name="$parentCancelButton" parentKey="CancelButton" hidden="true">
				<Size x="20" y="20"/>
				<Anchors>
					<Anchor point="RIGHT" x="-6" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parentTexture" parentKey="Texture" atlas="groupfinder-icon-redx" setAllPoints="true"/>
					</Layer>
				</Layers>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
				<Scripts>
					<OnClick function="LFGListSearchEntryCancel_OnClick"/>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText("Отменить заявку");
						GameTooltip:Show();
					</OnEnter>
					<OnLeave function="GameTooltip_Hide"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				LFGList_AddHighlight(self, "groupfinder-highlightbar-blue", nil, nil, 0.5);
			</OnLoad>
			<OnClick function="LFGListSearchEntry_OnClick"/>
			<OnDoubleClick function="LFGListSearchEntry_OnDoubleClick"/>
			<OnEnter function="LFGListSearchEntry_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<!-- an applicant of our group (retail LFGListApplicantTemplate) -->
	<Button name="LFGListApplicantTemplate" virtual="true">
		<Size x="296" y="34"/>
		<Layers>
			<Layer level="BACKGROUND">
