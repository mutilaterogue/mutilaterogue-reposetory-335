						<Anchor point="TOPRIGHT" x="-2" y="-21"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentBtnCornerRight" atlas="UI-Frame-BtnCornerRight" useAtlasSize="true">
