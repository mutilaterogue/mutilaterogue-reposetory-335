			</Frame>
			<Frame name="$parentHealer" parentKey="Healer" inherits="LFGListRoleCountTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentTank" relativePoint="RIGHT" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame name="$parentDamager" parentKey="Damager" inherits="LFGListRoleCountTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentHealer" relativePoint="RIGHT" x="0" y="0"/>
				</Anchors>
			</Frame>
			<!-- cancel our application -->
			<Button name="$parentCancelButton" parentKey="CancelButton" inherits="UIPanelCloseButton" hidden="true">
				<Size x="26" y="26"/>
				<Anchors>
					<Anchor point="RIGHT" x="-2" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick function="LFGListSearchEntryCancel_OnClick"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				LFGList_AddHighlight(self, "search-highlight");
			</OnLoad>
			<OnClick function="LFGListSearchEntry_OnClick"/>
			<OnDoubleClick function="LFGListSearchEntry_OnDoubleClick"/>
			<OnEnter function="LFGListSearchEntry_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

