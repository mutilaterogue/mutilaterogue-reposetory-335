						<Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
					</Anchors>
				</FontString>
				<FontString name="$parentPendingLabel" parentKey="PendingLabel" inherits="GameFontGreenSmall" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="TOPRIGHT" x="-30" y="-6"/>
					</Anchors>
				</FontString>
