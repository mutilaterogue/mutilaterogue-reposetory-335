						<Anchor point="LEFT" x="2" y="0"/>
						<Anchor point="RIGHT" x="-2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnTextChanged function="LFGListEditBox_OnTextChanged"/>
