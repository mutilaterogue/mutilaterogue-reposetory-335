				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentDeclineButton" parentKey="DeclineButton">
				<Size x="20" y="20"/>
				<Anchors>
					<Anchor point="RIGHT" x="-6" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parentTexture" parentKey="Texture" atlas="groupfinder-icon-redx" setAllPoints="true"/>
					</Layer>
				</Layers>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
				<Scripts>
					<OnClick function="LFGListApplicantDecline_OnClick"/>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText("Отклонить");
						GameTooltip:Show();
					</OnEnter>
					<OnLeave function="GameTooltip_Hide"/>
				</Scripts>
			</Button>
			<Button name="$parentInviteButton" parentKey="InviteButton" inherits="UIPanelButtonTemplate" text="INVITE">
				<Size x="72" y="22"/>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentDeclineButton" relativePoint="LEFT" x="-2" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick function="LFGListApplicantInvite_OnClick"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				LFGList_AddHighlight(self, "groupfinder-highlightbar-blue", nil, nil, 0.5);
			</OnLoad>
			<OnEnter function="LFGListApplicant_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<!-- ======================== the window ======================== -->
	<Frame name="LFGListFrame" parent="UIParent" hidden="true">
		<Size x="338" y="428"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture name="$parentTopTileStreaks" atlas="_UI-Frame-TopTileStreaks" useAtlasSize="true" horizTile="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="-21"/>
						<Anchor point="TOPRIGHT" x="-2" y="-21"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentBtnCornerRight" atlas="UI-Frame-BtnCornerRight" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
					</Anchors>
				</Texture>
				<Texture name="$parentButtonBottomBorder" atlas="_UI-Frame-BtnBotTile" useAtlasSize="true" horizTile="true">
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-23" y="2"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentBtnCornerRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>

