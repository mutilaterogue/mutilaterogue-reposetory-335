						<Anchor point="TOPRIGHT" relativeTo="$parentPendingLabel" relativePoint="BOTTOMRIGHT" x="0" y="-3"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelected" parentKey="Selected" atlas="search-select" hidden="true" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentTank" parentKey="Tank" inherits="LFGListRoleCountTemplate">
				<Anchors>
					<Anchor point="RIGHT" x="-60" y="0"/>
