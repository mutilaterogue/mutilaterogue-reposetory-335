<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Premade Groups (retail Blizzard_GroupFinder\LFGList.xml) for the server's group finder (server/premade_groups.cpp):
	     the categories, the search, the group creation, the applicants of our listed group and the sign up dialog.
	     The data and C_LFGList: LFGList.lua. Shown inside PVEFrame (PVEFrame.lua, tab 1 section 3).
	     Included by PVEFrame.xml before PVEFrame. -->
	<Script file="LFGList.lua"/>
	<Script file="LFGListFrame.lua"/>

	<!-- a category: its art, the cover, the name (retail LFGListCategoryTemplate) -->
	<Button name="LFGListCategoryTemplate" virtual="true">
		<Size x="300" y="46"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="290" y="36"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentCover" parentKey="Cover" atlas="groupfinder-button-cover" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentSelected" parentKey="SelectedTexture" atlas="groupfinder-button-select" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<FontString name="$parentLabel" parentKey="Label" inherits="GameFontNormalLarge">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				LFGList_AddHighlight(self, "groupfinder-button-highlight", 292, 37);
			</OnLoad>
			<OnClick function="LFGListCategoryButton_OnClick"/>
		</Scripts>
	</Button>

	<!-- a role count on a search result: the micro icon and the number -->
	<Frame name="LFGListRoleCountTemplate" virtual="true">
		<Size x="28" y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
				<FontString name="$parentCount" parentKey="Count" inherits="GameFontHighlightSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- a search result (retail LFGListSearchEntryTemplate) -->
	<Button name="LFGListSearchEntryTemplate" virtual="true">
		<Size x="296" y="36"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentResultBG" parentKey="ResultBG" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentName" parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Size x="176" y="14"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-4"/>
					</Anchors>
				</FontString>
				<FontString name="$parentActivityName" parentKey="ActivityName" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Size x="176" y="12"/>
