<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- The retail (12.1.5) group finder window (Blizzard_GroupFinder\PVEFrame.xml): one window, three tabs at the bottom
	     (dungeons and raids / PvP / Mythic+), the blue panel with the section buttons at the left. The 3.3.5 windows
	     (LFDParentFrame, LFRParentFrame, PVPParentFrame) and ChallengesFrame are shown inside it (PVEFrame.lua).
	     FrameXML.toc: GroupFinder\PVEFrame.xml at the end (after LFD / LFR / PVP and ChallengesUI). -->
	<Include file="RaidFinder.xml"/>
	<Include file="LFGListFrame.xml"/>
	<Include file="QueueStatus.xml"/>
	<Script file="PVEFrame.lua"/>

	<Button name="GroupFinderGroupButtonTemplate" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="203" y="60"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\Common\bluemenu-main" parentKey="bg">
					<Size x="224" y="80"/>
					<TexCoords left="0.00390625" right="0.87890625" top="0.75195313" bottom="0.83007813"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="icon">
					<Size x="66" y="66"/>
					<Anchors>
						<Anchor point="LEFT" x="2" y="-1"/>
					</Anchors>
				</Texture>
				<FontString name="$parentName" inherits="GameFontNormalLarge" parentKey="name" spacing="2" justifyH="LEFT">
					<Size x="106" y="0"/>
					<Anchors>
						<Anchor point="LEFT" x="83" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK" textureSubLevel="2">
				<Texture name="$parentRing" atlas="bluemenu-Ring" parentKey="ring">
					<Size x="95" y="96"/>
					<Anchors>
						<Anchor point="LEFT" x="-12" y="-1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<!-- the selected section -->
				<Texture parentKey="selected" file="Interface\Common\bluemenu-main" alphaMode="ADD" hidden="true">
					<Size x="224" y="80"/>
					<TexCoords left="0.00390625" right="0.87890625" top="0.75195313" bottom="0.83007813"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Common\bluemenu-main" alphaMode="ADD" alpha="0.8">
			<Size x="224" y="80"/>
			<TexCoords left="0.00390625" right="0.87890625" top="0.75195313" bottom="0.83007813"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<OnLoad function="GroupFinderGroupButton_OnLoad"/>
			<OnClick function="GroupFinderGroupButton_OnClick"/>
		</Scripts>
	</Button>

	<Frame name="PVEFrame" inherits="RetailPortraitFrameTemplate" enableMouse="true" movable="true" parent="UIParent" hidden="true" toplevel="true">
		<Size x="563" y="428"/>
		<Anchors>
			<Anchor point="TOPLEFT" x="16" y="-116"/>
		</Anchors>
		<Frames>
			<!-- the left panel: the blue menu art and the section buttons (tabs 1 and 2) -->
			<Frame name="GroupFinderFrame" setAllPoints="true">
				<Layers>
					<Layer level="BORDER" textureSubLevel="-1">
						<Texture name="PVEFrameBlueBg" file="Interface\Common\bluemenu-main">
							<Size x="209" y="399"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="7" y="-23"/>
							</Anchors>
							<TexCoords left="0.00390625" right="0.82421875" top="0.18554688" bottom="0.58984375"/>
						</Texture>
					</Layer>
					<Layer level="BORDER">
						<Texture file="Interface\Common\bluemenu-main">
							<Size x="185" y="55"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="PVEFrameBlueBg" x="12" y="-6"/>
							</Anchors>
							<TexCoords left="0.00390625" right="0.72656250" top="0.12988281" bottom="0.18359375"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-main">
							<Size x="185" y="55"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeTo="PVEFrameBlueBg" x="12" y="4"/>
							</Anchors>
							<TexCoords left="0.26171875" right="0.98437500" top="0.06542969" bottom="0.11914063"/>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<Texture name="PVEFrameTLCorner" file="Interface\Common\bluemenu-main">
							<Size x="64" y="64"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="PVEFrameBlueBg" x="0" y="0"/>
							</Anchors>
							<TexCoords left="0.00390625" right="0.25390625" top="0.00097656" bottom="0.06347656"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-main">
							<Size x="64" y="64"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="151" y="-23"/>
							</Anchors>
							<TexCoords left="0.51953125" right="0.76953125" top="0.00097656" bottom="0.06347656"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-main">
							<Size x="64" y="64"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="151" y="7"/>
							</Anchors>
							<TexCoords left="0.00390625" right="0.25390625" top="0.06542969" bottom="0.12792969"/>
						</Texture>
						<Texture name="PVEFrameBLCorner" file="Interface\Common\bluemenu-main">
							<Size x="64" y="64"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="7" y="7"/>
							</Anchors>
							<TexCoords left="0.26171875" right="0.51171875" top="0.00097656" bottom="0.06347656"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-vert" vertTile="true">
							<Size x="43" y="270"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="7" y="-87"/>
							</Anchors>
							<TexCoords left="0.06250000" right="0.39843750" top="0.00000000" bottom="1.00000000"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-vert" vertTile="true">
							<Size x="43" y="270"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="172" y="-87"/>
							</Anchors>
							<TexCoords left="0.41406250" right="0.75000000" top="0.00000000" bottom="1.00000000"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-goldborder-horiz" horizTile="true">
							<Size x="80" y="43"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeTo="PVEFrameBLCorner" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
							</Anchors>
							<TexCoords left="0.00000000" right="1.00000000" top="0.35937500" bottom="0.69531250"/>
						</Texture>
						<Texture file="Interface\Common\bluemenu-goldborder-horiz" horizTile="true">
							<Size x="80" y="43"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="PVEFrameTLCorner" relativePoint="TOPRIGHT" x="0" y="0"/>
							</Anchors>
							<TexCoords left="0.00000000" right="1.00000000" top="0.00781250" bottom="0.34375000"/>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<Button name="GroupFinderFrameGroupButton1" inherits="GroupFinderGroupButtonTemplate" id="1">
						<Anchors>
							<Anchor point="TOPLEFT" x="10" y="-70"/>
						</Anchors>
					</Button>
					<Button name="GroupFinderFrameGroupButton2" inherits="GroupFinderGroupButtonTemplate" id="2">
						<Anchors>
							<Anchor point="TOP" relativeTo="GroupFinderFrameGroupButton1" relativePoint="BOTTOM" x="0" y="-23"/>
						</Anchors>
					</Button>
					<Button name="GroupFinderFrameGroupButton3" inherits="GroupFinderGroupButtonTemplate" id="3">
						<Anchors>
							<Anchor point="TOP" relativeTo="GroupFinderFrameGroupButton2" relativePoint="BOTTOM" x="0" y="-23"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>

			<!-- the right side's dark inset (retail), under the stock windows' content -->
			<Frame name="PVEFrameRightInset" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="222" y="-24"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
				</Anchors>
			</Frame>
			<!-- retail tabs (TabSystem\TabSystemTemplates.xml) -->
			<Frame name="$parentTabSystem" parentKey="TabSystem" inherits="TabSystemTemplate">
				<KeyValues>
					<KeyValue key="minTabWidth" value="70" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="12" y="2"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad function="PVEFrame_OnLoad"/>
			<OnShow function="PVEFrame_OnShow"/>
			<OnHide function="PVEFrame_OnHide"/>
			<OnMouseDown>
				self:StartMoving();
			</OnMouseDown>
			<OnMouseUp>
				self:StopMovingOrSizing();
			</OnMouseUp>
		</Scripts>
	</Frame>
</Ui>
